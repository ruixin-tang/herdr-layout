{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "over9k"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ],
          "floating": [
            {
              "id": "forest-sprite",
              "content": {
                "mod": "forest-sprite"
              },
              "edge": "bottom",
              "align": "end"
            },
            {
              "id": "korok",
              "content": {
                "mod": "korok"
              },
              "edge": "bottom",
              "align": "start"
            }
          ]
        },
        {
          "id": "dev-servers",
          "type": "block",
          "content": {
            "mod": "dev-servers"
          },
          "size": {
            "px": 80
          }
        },
        {
          "id": "usage",
          "type": "block",
          "content": {
            "mod": "over9k-usage"
          },
          "size": {
            "px": 150
          }
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "over9k-footer",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 97
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "over9k-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main-col",
              "type": "column",
              "gap": 8,
              "children": [
                {
                  "id": "crew",
                  "type": "block",
                  "content": {
                    "mod": "crew"
                  },
                  "size": {
                    "px": 260
                  }
                },
                {
                  "id": "main",
                  "type": "block",
                  "content": {
                    "tab": "active",
                    "pane": {
                      "header": {
                        "content": {
                          "mod": "pane"
                        },
                        "reveal": "always",
                        "height": 30,
                        "position": "top"
                      },
                      "background": "#0c1a20d9",
                      "border": {
                        "width": 1,
                        "color": "border"
                      },
                      "focus": {
                        "width": 2,
                        "color": "accent"
                      },
                      "radius": 4,
                      "gap": 8,
                      "lone": true
                    }
                  }
                }
              ]
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "todos",
                      "type": "block",
                      "content": {
                        "mod": "over9k-todos"
                      }
                    },
                    {
                      "id": "my-work",
                      "type": "block",
                      "content": {
                        "mod": "my-work"
                      }
                    }
                  ],
                  "active": "files"
                },
                {
                  "id": "support-duty",
                  "type": "block",
                  "content": {
                    "mod": "support-duty"
                  },
                  "size": {
                    "px": 36
                  }
                },
                {
                  "id": "weather",
                  "type": "block",
                  "content": {
                    "mod": "weather"
                  },
                  "size": {
                    "px": 128
                  }
                },
                {
                  "id": "trains",
                  "type": "block",
                  "content": {
                    "mod": "trains"
                  },
                  "size": {
                    "px": 124
                  }
                },
                {
                  "id": "agenda",
                  "type": "block",
                  "content": {
                    "mod": "agenda"
                  },
                  "size": {
                    "px": 230
                  }
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true,
              "gap": 8
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          }
        }
      ],
      "resizable": false
    }
  ],
  "background": {
    "gradient": [
      "#0e2e38",
      "#050d10"
    ],
    "angle": 165
  },
  "theme": "sheikah",
  "terminal_padding": [
    14,
    12
  ],
  "terminal_opacity": 0.92,
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "preview": "layouts/over9k.svg",
  "terminal_menu": "over9k-menu"
}
